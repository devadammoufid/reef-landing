---
import Layout from "../layouts/Layout.astro"

const APP = "https://reef.moaj.info"
const CONTACT = "mailto:contact@moaj.info"

const chain = [
  { n: "01", t: "Extraction", d: "Tonnage extrait par site et par matériau, chaque jour." },
  { n: "02", t: "Transport", d: "Rotations mine → usine → port, charge et flotte suivies." },
  { n: "03", t: "Flottation", d: "Alimentation, concentré produit et taux de récupération." },
  { n: "04", t: "Production", d: "Lots, teneurs et conformité qualité en un coup d'œil." },
  { n: "05", t: "Port", d: "Navires, quais et tonnage expédié à l'export." },
  { n: "06", t: "Ventes", d: "Commandes, incoterms et pipeline commercial valorisé." },
]

const features = [
  { t: "Temps réel, pas rétroviseur", d: "La donnée remonte du terrain au tableau de bord en continu. Vous décidez sur des chiffres d'aujourd'hui, pas du reporting de la semaine dernière." },
  { t: "La récupération sous contrôle", d: "Suivez le rendement métallurgique de chaque circuit de flottation et repérez la dérive avant qu'elle ne coûte des tonnes." },
  { t: "Stocks sur tous les sites", d: "Minerai, concentré, réactifs, carburant — les niveaux par site et les mouvements, sans un seul tableur." },
  { t: "De la commande à l'expédition", d: "Produits, clients, commandes et valeur du pipeline. La chaîne commerciale reliée à la production réelle." },
  { t: "Rapports & exports", d: "Des indicateurs prêts pour la direction, exportables. Fini les consolidations manuelles du lundi matin." },
  { t: "Rôles & accès", d: "Chaque équipe voit ce qui la concerne. Direction, usine, transport, port — un accès par métier." },
]

const audience = [
  { t: "Usines de traitement", d: "Pilotez la flottation, la production et la qualité, et reliez-les à vos stocks et vos ventes." },
  { t: "Sites d'extraction", d: "Suivez le tonnage, les équipes et les équipements, et alimentez la chaîne aval en temps réel." },
  { t: "Groupes multi-sites", d: "Une seule plateforme pour toutes vos exploitations, chacune isolée et à votre marque." },
]

const plans = [
  { name: "Starter", who: "Un site, l'essentiel", price: "Sur devis", feats: ["Chaîne mine → port", "Tableau de bord temps réel", "Jusqu'à 10 utilisateurs", "Support par email"], hot: false },
  { name: "Business", who: "Le choix des exploitations", price: "Sur devis", feats: ["Tout Starter", "Modules complets & rapports", "Utilisateurs illimités", "Support prioritaire", "Marque personnalisée"], hot: true },
  { name: "Enterprise", who: "Groupes multi-sites", price: "Sur mesure", feats: ["Tout Business", "Sites illimités", "Déploiement dédié", "Intégrations sur mesure", "Accompagnement dédié"], hot: false },
]
---

<Layout>
  <!-- Header -->
  <header class="hdr">
    <div class="wrap hdr-in">
      <a class="logo" href="/" aria-label="Reef">
        <svg width="34" height="34" viewBox="0 0 64 64" fill="none" aria-hidden="true">
          <rect width="64" height="64" rx="14" fill="#1B2233"></rect>
          <g transform="translate(9.6,9.6) scale(0.7)">
            <polygon points="32,6 58,13 32,20 6,13" fill="#E0A100"></polygon>
            <polygon points="32,24 58,31 32,38 6,31" fill="#F4F6FA"></polygon>
            <polygon points="32,42 58,49 32,56 6,49" fill="#F4F6FA" opacity="0.5"></polygon>
          </g>
        </svg>
        <span class="logo-word">Re<span class="brand-text">ef</span></span>
      </a>
      <nav class="nav">
        <a href="#chaine">Plateforme</a>
        <a href="#fonctions">Fonctionnalités</a>
        <a href="#tarifs">Tarifs</a>
        <a href={APP}>Connexion</a>
      </nav>
      <a class="btn btn-primary hdr-cta" href={CONTACT}>Demander une démo</a>
    </div>
  </header>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-grid"></div>
    <div class="hero-glow"></div>
    <div class="wrap hero-in">
      <span class="eyebrow">Plateforme d'opérations minérales</span>
      <h1>
        Pilotez toute votre exploitation,<br />
        <span class="brand-text">de la mine au port.</span>
      </h1>
      <p class="lead">
        Extraction, transport, usine de flottation, production, port et ventes — une seule plateforme,
        en temps réel. Reef, ce n'est pas un ERP de plus : c'est votre poste de commandement.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={CONTACT}>Demander une démo</a>
        <a class="btn btn-ghost-dark" href={APP}>Voir la plateforme →</a>
      </div>
      <div class="hero-stats">
        <div><b>Mine → Port</b><span>Chaîne complète, une seule vue</span></div>
        <div><b>Temps réel</b><span>Zéro tableur, zéro angle mort</span></div>
        <div><b>Multi-sites</b><span>Chaque exploitation, à votre marque</span></div>
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="section">
    <div class="wrap problem">
      <span class="eyebrow">Le vrai problème</span>
      <h2>Le minerai bouge. Vos données, non.</h2>
      <p class="sub">
        Les tonnages dorment dans des tableurs, la récupération se découvre en fin de mois, et personne
        n'a la même version des chiffres. Reef relie chaque étape de votre chaîne pour que vous arrêtiez
        de piloter à l'aveugle.
      </p>
    </div>
  </section>

  <!-- Value chain -->
  <section class="section chainsec" id="chaine">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">La chaîne de valeur</span>
        <h2>De l'extraction à l'expédition, tout se tient.</h2>
        <p class="sub">Chaque maillon alimente le suivant. Vous suivez le flux réel, pas une photo figée.</p>
      </div>
      <div class="chain">
        {chain.map((s) => (
          <div class="chain-card">
            <span class="chain-n">{s.n}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="section featsec" id="fonctions">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Ce que vous gagnez</span>
        <h2>Moins de tableurs. Plus de décisions.</h2>
      </div>
      <div class="feats">
        {features.map((f) => (
          <div class="feat">
            <div class="feat-dot"></div>
            <h3>{f.t}</h3>
            <p>{f.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- White-label / multi-site -->
  <section class="section wl">
    <div class="wrap wl-in">
      <div>
        <span class="eyebrow">Multi-sites & marque blanche</span>
        <h2>Plusieurs exploitations ? Une seule plateforme.</h2>
        <p class="sub">
          Chaque site est cloisonné : ses données restent les siennes. Et l'ensemble porte votre marque —
          votre nom, votre logo, vos couleurs. Vos équipes se connectent à leur outil, pas au nôtre.
        </p>
        <ul class="ticks">
          <li>Données isolées par site, sans mélange possible</li>
          <li>Marque, logo et couleurs personnalisés</li>
          <li>Accès par rôle et par métier</li>
        </ul>
      </div>
      <div class="wl-card">
        <div class="wl-row"><span>Site A — Kolwezi</span><em class="ok">Actif</em></div>
        <div class="wl-row"><span>Site B — Tenke</span><em class="ok">Actif</em></div>
        <div class="wl-row"><span>Usine — Flottation</span><em class="ok">92,4% récup.</em></div>
        <div class="wl-row"><span>Port — Export</span><em class="ok">10 400 T</em></div>
        <div class="wl-foot">Une console, chaque site à sa place.</div>
      </div>
    </div>
  </section>

  <!-- Audience -->
  <section class="section">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Pour qui</span>
        <h2>Fait pour ceux qui font tourner la mine.</h2>
      </div>
      <div class="aud">
        {audience.map((a) => (
          <div class="aud-card">
            <h3>{a.t}</h3>
            <p>{a.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section pricesec" id="tarifs">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Tarifs</span>
        <h2>Une licence annuelle, claire.</h2>
        <p class="sub">Pas de coûts cachés, pas d'usine à gaz. Vous payez la plateforme, on s'occupe du reste.</p>
      </div>
      <div class="plans">
        {plans.map((p) => (
          <div class:list={["plan", { hot: p.hot }]}>
            {p.hot && <span class="plan-badge">Le plus choisi</span>}
            <h3>{p.name}</h3>
            <p class="plan-who">{p.who}</p>
            <div class="plan-price">{p.price}</div>
            <ul>
              {p.feats.map((f) => <li>{f}</li>)}
            </ul>
            <a class:list={["btn", p.hot ? "btn-primary" : "btn-ghost"]} href={CONTACT}>Demander un devis</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="cta">
    <div class="hero-glow"></div>
    <div class="wrap cta-in">
      <h2>Prêt à reprendre le contrôle de votre chaîne ?</h2>
      <p>Une démo de 20 minutes suffit pour voir vos opérations, de la mine au port, dans un seul écran.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={CONTACT}>Demander une démo</a>
        <a class="btn btn-ghost-dark" href={APP}>Explorer la plateforme →</a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="ftr">
    <div class="wrap ftr-in">
      <div class="ftr-brand">
        <a class="logo" href="/" aria-label="Reef">
          <svg width="30" height="30" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <rect width="64" height="64" rx="14" fill="#1B2233"></rect>
            <g transform="translate(9.6,9.6) scale(0.7)">
              <polygon points="32,6 58,13 32,20 6,13" fill="#E0A100"></polygon>
              <polygon points="32,24 58,31 32,38 6,31" fill="#F4F6FA"></polygon>
              <polygon points="32,42 58,49 32,56 6,49" fill="#F4F6FA" opacity="0.5"></polygon>
            </g>
          </svg>
          <span class="logo-word" style="color:#fff">Re<span class="brand-text">ef</span></span>
        </a>
        <p>La plateforme d'opérations minérales — de la mine au port, en temps réel.</p>
      </div>
      <div class="ftr-links">
        <a href="#chaine">Plateforme</a>
        <a href="#fonctions">Fonctionnalités</a>
        <a href="#tarifs">Tarifs</a>
        <a href={APP}>Connexion</a>
        <a href={CONTACT}>Contact</a>
      </div>
    </div>
    <div class="wrap ftr-legal">
      <span>© {new Date().getFullYear()} Reef — Mineral Operations Platform.</span>
      <span>Conçu pour l'industrie minière.</span>
    </div>
  </footer>
</Layout>

<style>
  /* Header */
  .hdr { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.82); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .hdr-in { display: flex; align-items: center; justify-content: space-between; height: 68px; }
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  .logo-word { font-family: var(--display); font-weight: 700; font-size: 20px; letter-spacing: -0.02em; }
  .nav { display: flex; gap: 28px; font-size: 14px; font-weight: 500; color: var(--muted); }
  .nav a:hover { color: var(--ink); }
  @media (max-width: 860px) { .nav { display: none; } }
  @media (max-width: 520px) { .hdr-cta { display: none; } }

  /* Hero */
  .hero { position: relative; background: #12161f; color: #fff; overflow: hidden; padding: 96px 0 84px; }
  .hero-grid { position: absolute; inset: 0; opacity: .5;
    background-image: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
    background-size: 48px 48px; -webkit-mask-image: radial-gradient(ellipse at 50% 0%, #000 40%, transparent 78%); mask-image: radial-gradient(ellipse at 50% 0%, #000 40%, transparent 78%); }
  .hero-glow { position: absolute; top: -140px; right: -80px; width: 520px; height: 520px; border-radius: 50%;
    background: radial-gradient(circle, rgba(224,161,0,.28), transparent 60%); filter: blur(20px); pointer-events: none; }
  .hero-in { position: relative; }
  .hero h1 { font-size: 60px; margin: 20px 0 0; }
  .hero .lead { color: rgba(255,255,255,.66); font-size: 19px; max-width: 640px; margin-top: 22px; }
  .hero-cta { display: flex; gap: 12px; margin-top: 32px; flex-wrap: wrap; }
  .hero-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 56px; max-width: 760px; }
  .hero-stats > div { border-left: 2px solid var(--brand); padding-left: 14px; }
  .hero-stats b { display: block; font-family: var(--display); font-size: 18px; }
  .hero-stats span { color: rgba(255,255,255,.5); font-size: 13px; }
  @media (max-width: 720px) { .hero h1 { font-size: 38px; } .hero-stats { grid-template-columns: 1fr; gap: 12px; } }

  /* Section heads */
  .head { max-width: 640px; margin-bottom: 44px; }
  .head h2, .problem h2 { font-size: 36px; margin-top: 12px; }
  .sub { color: var(--muted); font-size: 18px; margin-top: 14px; }
  .problem { max-width: 720px; }
  .problem h2 { font-size: 40px; }

  /* Value chain */
  .chainsec { background: var(--canvas); }
  .chain { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .chain-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; transition: all .18s ease; }
  .chain-card:hover { border-color: var(--brand); transform: translateY(-3px); box-shadow: 0 12px 30px rgba(18,22,31,.06); }
  .chain-n { font-family: var(--display); font-weight: 700; font-size: 14px; color: var(--brand); letter-spacing: .1em; }
  .chain-card h3 { font-size: 20px; margin: 10px 0 8px; }
  .chain-card p { color: var(--muted); font-size: 15px; }
  @media (max-width: 860px) { .chain { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .chain { grid-template-columns: 1fr; } }

  /* Features */
  .feats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px 40px; }
  .feat-dot { width: 40px; height: 40px; border-radius: 11px; background: linear-gradient(145deg, var(--brand-2), var(--brand)); margin-bottom: 16px;
    -webkit-mask: none; box-shadow: 0 6px 16px rgba(224,161,0,.28); }
  .feat h3 { font-size: 19px; margin-bottom: 8px; }
  .feat p { color: var(--muted); font-size: 15px; }
  @media (max-width: 860px) { .feats { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .feats { grid-template-columns: 1fr; } }

  /* White-label */
  .wl { background: var(--canvas); }
  .wl-in { display: grid; grid-template-columns: 1.05fr .95fr; gap: 48px; align-items: center; }
  .wl h2 { font-size: 34px; margin-top: 12px; }
  .ticks { list-style: none; padding: 0; margin: 22px 0 0; display: grid; gap: 12px; }
  .ticks li { position: relative; padding-left: 30px; color: var(--ink); font-weight: 500; }
  .ticks li::before { content: "✓"; position: absolute; left: 0; top: -1px; width: 20px; height: 20px; border-radius: 6px; background: var(--brand); color: #1a1400; font-size: 12px; font-weight: 800; display: grid; place-items: center; }
  .wl-card { background: #12161f; border-radius: 20px; padding: 26px; color: #fff; box-shadow: 0 24px 60px rgba(18,22,31,.18); }
  .wl-row { display: flex; align-items: center; justify-content: space-between; padding: 14px 0; border-bottom: 1px solid var(--line-dark); font-size: 15px; }
  .wl-row span { color: rgba(255,255,255,.82); }
  .wl-row em { font-style: normal; font-weight: 600; font-size: 13px; color: #34d399; background: rgba(52,211,153,.12); padding: 4px 10px; border-radius: 999px; }
  .wl-foot { color: rgba(255,255,255,.45); font-size: 13px; margin-top: 16px; }
  @media (max-width: 820px) { .wl-in { grid-template-columns: 1fr; gap: 32px; } }

  /* Audience */
  .aud { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .aud-card { border: 1px solid var(--line); border-radius: var(--radius); padding: 26px; }
  .aud-card h3 { font-size: 19px; margin-bottom: 8px; }
  .aud-card p { color: var(--muted); font-size: 15px; }
  @media (max-width: 780px) { .aud { grid-template-columns: 1fr; } }

  /* Pricing */
  .pricesec { background: var(--canvas); }
  .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: start; }
  .plan { position: relative; background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 30px 26px; }
  .plan.hot { border-color: var(--brand); box-shadow: 0 18px 44px rgba(224,161,0,.16); transform: translateY(-6px); }
  .plan-badge { position: absolute; top: -12px; left: 26px; background: var(--brand); color: #1a1400; font-size: 12px; font-weight: 700; padding: 5px 12px; border-radius: 999px; }
  .plan h3 { font-size: 22px; }
  .plan-who { color: var(--muted); font-size: 14px; margin-top: 4px; }
  .plan-price { font-family: var(--display); font-size: 30px; font-weight: 700; margin: 18px 0; }
  .plan ul { list-style: none; padding: 0; margin: 0 0 24px; display: grid; gap: 11px; }
  .plan li { position: relative; padding-left: 26px; font-size: 15px; color: var(--ink); }
  .plan li::before { content: "✓"; position: absolute; left: 0; color: var(--brand); font-weight: 800; }
  .plan .btn { width: 100%; }
  @media (max-width: 820px) { .plans { grid-template-columns: 1fr; } .plan.hot { transform: none; } }

  /* Final CTA */
  .cta { position: relative; background: #12161f; color: #fff; text-align: center; padding: 90px 0; overflow: hidden; }
  .cta-in { position: relative; max-width: 680px; margin: 0 auto; }
  .cta h2 { font-size: 38px; }
  .cta p { color: rgba(255,255,255,.6); font-size: 18px; margin-top: 14px; }
  .cta .hero-cta { justify-content: center; }

  /* Footer */
  .ftr { background: #0e1117; color: rgba(255,255,255,.6); padding: 56px 0 28px; }
  .ftr-in { display: flex; justify-content: space-between; gap: 32px; flex-wrap: wrap; padding-bottom: 32px; border-bottom: 1px solid var(--line-dark); }
  .ftr-brand p { max-width: 320px; font-size: 14px; margin-top: 14px; }
  .ftr-links { display: flex; gap: 24px; flex-wrap: wrap; font-size: 14px; align-items: center; }
  .ftr-links a:hover { color: var(--brand); }
  .ftr-legal { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 13px; color: rgba(255,255,255,.4); padding-top: 24px; }
</style>
