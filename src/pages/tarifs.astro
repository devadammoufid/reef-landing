---
import Layout from "../layouts/Layout.astro"
const CONTACT = "/contact"

const plans = [
  { name: "Starter", who: "Un site, l'essentiel", price: "Sur devis", note: "Licence annuelle", feats: ["Chaîne mine → port", "Tableau de bord temps réel", "Jusqu'à 10 utilisateurs", "Support par email"], hot: false },
  { name: "Business", who: "Le choix des exploitations", price: "Sur devis", note: "Licence annuelle", feats: ["Tout Starter", "Modules complets & rapports", "Utilisateurs illimités", "Marque personnalisée", "Support prioritaire"], hot: true },
  { name: "Enterprise", who: "Groupes multi-sites", price: "Sur mesure", note: "Contrat annuel", feats: ["Tout Business", "Sites illimités", "Déploiement dédié", "Intégrations sur mesure", "Accompagnement dédié"], hot: false },
]

const matrix = [
  { f: "Chaîne mine → port en temps réel", s: true, b: true, e: true },
  { f: "Tous les modules opérationnels", s: true, b: true, e: true },
  { f: "Rapports & exports", s: "Standard", b: "Avancés", e: "Sur mesure" },
  { f: "Utilisateurs", s: "10", b: "Illimités", e: "Illimités" },
  { f: "Sites / exploitations", s: "1", b: "Plusieurs", e: "Illimités" },
  { f: "Marque blanche (logo, couleurs)", s: false, b: true, e: true },
  { f: "Isolation des données par site", s: true, b: true, e: true },
  { f: "Support", s: "Email", b: "Prioritaire", e: "Dédié" },
  { f: "Déploiement dédié / intégrations", s: false, b: false, e: true },
]

const faq = [
  { q: "Comment fonctionne la facturation ?", a: "Reef se facture par licence annuelle, adaptée à votre nombre de sites et d'utilisateurs. Pas de coûts cachés : vous payez la plateforme, on s'occupe de l'hébergement et des mises à jour." },
  { q: "Mes données sont-elles isolées des autres clients ?", a: "Oui. Chaque client — et chaque site — dispose d'un espace cloisonné. Vos chiffres ne croisent jamais ceux d'une autre exploitation." },
  { q: "Peut-on mettre notre propre marque ?", a: "Oui, dès la formule Business : votre nom, votre logo et vos couleurs. Vos équipes utilisent votre outil, pas le nôtre." },
  { q: "Faut-il installer quelque chose ?", a: "Non. Reef est une plateforme web : vos équipes s'y connectent depuis un navigateur, sur site ou au bureau. Rien à installer, rien à maintenir." },
  { q: "Combien de temps pour démarrer ?", a: "Un site simple peut être opérationnel en quelques jours. Les déploiements multi-sites font l'objet d'un accompagnement dédié." },
  { q: "Peut-on importer nos données existantes ?", a: "Oui — parlons-en en démo. On cadre vos sources (tableurs, systèmes en place) et le plan de reprise." },
]
---

<Layout title="Tarifs — Reef" description="Licences annuelles Reef : Starter, Business et Enterprise. Sur devis, sans coûts cachés.">
  <section class="pagehero">
    <div class="grid"></div><div class="glow"></div>
    <div class="wrap inner">
      <span class="eyebrow">Tarifs</span>
      <h1>Une licence annuelle, claire.</h1>
      <p>Pas de coûts cachés, pas d'usine à gaz. Vous payez la plateforme, on s'occupe du reste.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="plans">
        {plans.map((p) => (
          <div class:list={["plan", { hot: p.hot }]}>
            {p.hot && <span class="plan-badge">Le plus choisi</span>}
            <h3>{p.name}</h3>
            <p class="plan-who">{p.who}</p>
            <div class="plan-price">{p.price}</div>
            <div class="plan-note">{p.note}</div>
            <ul>{p.feats.map((f) => <li>{f}</li>)}</ul>
            <a class:list={["btn", p.hot ? "btn-primary" : "btn-ghost"]} href={CONTACT}>Demander un devis</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Comparison -->
  <section class="section section-alt">
    <div class="wrap">
      <div class="head"><span class="eyebrow">Comparatif</span><h2>Ce que couvre chaque formule.</h2></div>
      <div class="tablewrap">
        <table class="cmp">
          <thead>
            <tr><th></th><th>Starter</th><th class="hotcol">Business</th><th>Enterprise</th></tr>
          </thead>
          <tbody>
            {matrix.map((r) => (
              <tr>
                <td class="fname">{r.f}</td>
                {[r.s, r.b, r.e].map((v, idx) => (
                  <td class:list={[{ hotcol: idx === 1 }]}>
                    {v === true ? <span class="yes">✓</span> : v === false ? <span class="no">—</span> : <span class="val">{v}</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="wrap faqwrap">
      <div class="head left"><span class="eyebrow">Questions fréquentes</span><h2>Ce qu'on nous demande.</h2></div>
      <div class="faq">
        {faq.map((item) => (
          <details class="qa">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap cta-in">
      <h2>Un devis en une conversation.</h2>
      <p>Dites-nous votre nombre de sites et d'utilisateurs — on revient avec une proposition claire.</p>
      <a class="btn btn-primary" href={CONTACT}>Demander un devis</a>
    </div>
  </section>
</Layout>

<style>
  .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: start; }
  .plan { position: relative; background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 30px 26px; }
  .plan.hot { border-color: var(--brand); box-shadow: 0 18px 44px rgba(224,161,0,.16); transform: translateY(-6px); }
  .plan-badge { position: absolute; top: -12px; left: 26px; background: var(--brand); color: #1a1400; font-size: 12px; font-weight: 700; padding: 5px 12px; border-radius: 999px; }
  .plan h3 { font-size: 22px; }
  .plan-who { color: var(--muted); font-size: 14px; margin-top: 4px; }
  .plan-price { font-family: var(--display); font-size: 30px; font-weight: 700; margin: 16px 0 2px; }
  .plan-note { color: var(--muted); font-size: 13px; margin-bottom: 18px; }
  .plan ul { list-style: none; padding: 0; margin: 0 0 24px; display: grid; gap: 11px; }
  .plan li { position: relative; padding-left: 26px; font-size: 15px; }
  .plan li::before { content: "✓"; position: absolute; left: 0; color: var(--brand); font-weight: 800; }
  .plan .btn { width: 100%; }
  @media (max-width: 820px) { .plans { grid-template-columns: 1fr; } .plan.hot { transform: none; } }

  .tablewrap { overflow-x: auto; }
  .cmp { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .cmp th, .cmp td { padding: 15px 18px; text-align: center; border-bottom: 1px solid var(--line); font-size: 15px; }
  .cmp thead th { font-family: var(--display); font-size: 15px; background: #fbfbfd; }
  .cmp .fname { text-align: left; font-weight: 500; color: var(--ink); }
  .cmp .hotcol { background: rgba(224,161,0,.06); }
  .cmp thead .hotcol { color: var(--brand); }
  .yes { color: var(--brand); font-weight: 800; }
  .no { color: #c2c7d0; }
  .val { color: var(--muted); font-weight: 600; }

  .faqwrap { max-width: 820px; }
  .faq { display: grid; gap: 12px; }
  .qa { border: 1px solid var(--line); border-radius: 12px; padding: 4px 20px; }
  .qa summary { cursor: pointer; font-family: var(--display); font-weight: 600; font-size: 17px; padding: 16px 0; list-style: none; display: flex; justify-content: space-between; align-items: center; }
  .qa summary::-webkit-details-marker { display: none; }
  .qa summary::after { content: "+"; color: var(--brand); font-size: 22px; font-weight: 400; }
  .qa[open] summary::after { content: "−"; }
  .qa p { color: var(--muted); font-size: 15px; padding: 0 0 18px; }

  .cta { background: #12161f; color: #fff; text-align: center; padding: 80px 0; }
  .cta-in { max-width: 620px; margin: 0 auto; }
  .cta h2 { font-size: 34px; }
  .cta p { color: rgba(255,255,255,.6); font-size: 17px; margin: 14px 0 28px; }
</style>
