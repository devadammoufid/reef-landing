---
import Layout from "../layouts/Layout.astro"
const CONTACT_EMAIL = "contact@moaj.info"
const APP = "https://reef.moaj.info"
---

<Layout title="Contact — Reef" description="Demandez une démo de Reef, la plateforme d'opérations minérales.">
  <section class="pagehero">
    <div class="grid"></div><div class="glow"></div>
    <div class="wrap inner">
      <span class="eyebrow">Contact</span>
      <h1>Voyons Reef sur vos opérations.</h1>
      <p>20 minutes, une démo guidée, et vos questions. Dites-nous où vous en êtes — on s'occupe du reste.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap contact">
      <!-- Form -->
      <form id="demo-form" class="form">
        <div class="row">
          <div class="field"><label for="name">Nom</label><input id="name" name="name" required placeholder="Votre nom" /></div>
          <div class="field"><label for="company">Entreprise</label><input id="company" name="company" placeholder="Votre société" /></div>
        </div>
        <div class="row">
          <div class="field"><label for="email">Email professionnel</label><input id="email" name="email" type="email" required placeholder="vous@entreprise.com" /></div>
          <div class="field"><label for="sites">Nombre de sites</label><input id="sites" name="sites" placeholder="1, 2, 5…" /></div>
        </div>
        <div class="field"><label for="message">Votre besoin</label><textarea id="message" name="message" rows="4" placeholder="Dites-nous ce que vous cherchez à piloter…"></textarea></div>
        <button type="submit" class="btn btn-primary">Envoyer ma demande</button>
        <p class="hint">Votre client email s'ouvrira avec la demande préremplie.</p>
      </form>

      <!-- Aside -->
      <aside class="aside">
        <div class="aside-card">
          <h3>Par email</h3>
          <p>Écrivez-nous directement — on répond vite.</p>
          <a class="link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        </div>
        <div class="aside-card">
          <h3>Déjà client ?</h3>
          <p>Accédez à votre plateforme.</p>
          <a class="link" href={APP}>Se connecter →</a>
        </div>
        <div class="aside-card muted">
          <h3>Ce qui se passe ensuite</h3>
          <ul class="ticks">
            <li>On cadre votre besoin en 20 min</li>
            <li>Démo sur un cas proche du vôtre</li>
            <li>Proposition claire, sur devis</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <script is:inline define:vars={{ CONTACT_EMAIL }}>
    const form = document.getElementById("demo-form")
    form?.addEventListener("submit", (e) => {
      e.preventDefault()
      const f = new FormData(form)
      const body =
        `Nom: ${f.get("name") || ""}\n` +
        `Entreprise: ${f.get("company") || ""}\n` +
        `Email: ${f.get("email") || ""}\n` +
        `Nombre de sites: ${f.get("sites") || ""}\n\n` +
        `${f.get("message") || ""}`
      const subject = `Demande de démo Reef — ${f.get("company") || f.get("name") || ""}`
      window.location.href = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`
    })
  </script>
</Layout>

<style>
  .contact { display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px; align-items: start; }
  .form { display: grid; gap: 18px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .field { display: grid; gap: 7px; }
  .field label { font-size: 14px; font-weight: 600; }
  .field input, .field textarea { font-family: var(--font); font-size: 15px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 11px; background: #fff; color: var(--ink); width: 100%; }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px rgba(224,161,0,.15); }
  .form .btn { justify-self: start; }
  .hint { color: var(--muted); font-size: 13px; }

  .aside { display: grid; gap: 16px; }
  .aside-card { border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; }
  .aside-card.muted { background: var(--canvas); }
  .aside-card h3 { font-size: 17px; margin-bottom: 6px; }
  .aside-card p { color: var(--muted); font-size: 14.5px; margin-bottom: 8px; }
  .link { color: var(--brand); font-weight: 600; }
  .aside-card .ticks { margin-top: 4px; }
  .aside-card .ticks li { font-weight: 400; font-size: 14.5px; }
  @media (max-width: 760px) { .contact { grid-template-columns: 1fr; } .row { grid-template-columns: 1fr; } }
</style>
